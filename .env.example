# OPTIONAL. `docker compose up -d` works without this file.
# Passwords and keys are generated automatically on first start and stored in
# the `huddle-secrets` Docker volume. Never commit a filled-in .env.

# Public addresses people's browsers use. Change when hosting on a real domain,
# e.g. PUBLIC_APP_URL=https://quiz.example.com  PUBLIC_API_URL=https://api.quiz.example.com
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Host ports
PORT=3000
API_PORT=8000

# Sign-ups are confirmed instantly. Set false only if SMTP below is configured.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# "Continue with Google" — off unless you add your own Google OAuth app
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the "Sponsor" buttons point
DONATE_URL=https://github.com/sponsors/orendrasingh
